DirectoryIndex index.html

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/(proposal|company-card|rental)$ api.py?action=$1 [L,QSA]
  RewriteRule ^(server|avito_telegram_bridge)\.py$ - [F,L]
</IfModule>

Options +ExecCGI
AddHandler cgi-script .py

<FilesMatch "^(\.env|\.git|.*\.pyc)$">
  Require all denied
</FilesMatch>

RedirectMatch 403 ^/crm/vendor/
RedirectMatch 403 ^/crm/__pycache__/
