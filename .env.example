SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=info-misterpufik@yandex.ru
SMTP_FROM=info-misterpufik@yandex.ru
NOTIFY_EMAIL_TO=info-misterpufik@yandex.ru
SMTP_PASSWORD=your_yandex_app_password

IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_USER=info-misterpufik@yandex.ru
IMAP_PASSWORD=your_yandex_app_password

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Old integration name; works as an alias for TELEGRAM_CHAT_ID.
TELEGRAM_TARGET=
TELEGRAM_WEBHOOK_SECRET=

# Optional: send different sources to different Telegram chats.
TELEGRAM_CHAT_ID_AVITO=
TELEGRAM_CHAT_ID_WHATSAPP=
TELEGRAM_CHAT_ID_YANDEX=

# Optional: if TELEGRAM_CHAT_ID is a forum group, use separate topics.
TELEGRAM_THREAD_ID_AVITO=
TELEGRAM_THREAD_ID_WHATSAPP=
TELEGRAM_THREAD_ID_YANDEX=

# Optional: send email copies from different sources to different mailboxes.
NOTIFY_EMAIL_TO_AVITO=
NOTIFY_EMAIL_TO_WHATSAPP=

# Database for calculator/CRM state.
# On Beget hosting use DB_HOST=localhost. For outside connections use mrpuffch.beget.tech
# if external MySQL access is enabled for the database user.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mrpuffch_main
DB_USER=mrpuffch_main
DB_PASSWORD=

# FTP deploy for CRM hosting. Keep real values only in local .env.
FTP_HOST=misterpufik.ru
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/misterpufik.ru/public_html/crm
